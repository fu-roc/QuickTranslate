<Window x:Class="QuickTranslate.Windows.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        Focusable="True"
        Title="">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent">
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="#FFFFFFFF"
                       StrokeThickness="1"
                       Fill="#33007ACC"
                       Visibility="Collapsed" />
        </Canvas>
        <TextBlock Text="拖拽框选要识别的文字 · Esc 取消"
                   Foreground="White"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,24,0,0"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
