<Window x:Class="QuickTranslate.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Style="{StaticResource DesktopWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Loaded="Window_OnLoaded" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="UpdateSuccessTint" Color="#E8F6EE" />
        <SolidColorBrush x:Key="UpdateErrorTint" Color="#FCEFED" />
    </Window.Resources>

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusTile" Width="38" Height="38" CornerRadius="8"
                            Background="{StaticResource HighlightBrush}" VerticalAlignment="Top">
                        <TextBlock x:Name="StatusIcon" FontSize="21" FontFamily="Segoe UI Symbol"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="StatusIconRotation" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" LineHeight="20"
                                   Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,14,0,0" Padding="0,12,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前版本" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="CurrentVersionText" Margin="0,3,0,0"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel x:Name="LatestVersionPanel" Grid.Column="1" Visibility="Collapsed">
                            <TextBlock Text="最新版本" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="LatestVersionText" Margin="0,3,0,0"
                                       FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="NotesPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0"
                Padding="16,12" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="发布说明"
                           Style="{StaticResource SectionTitle}" Margin="0,0,0,7" />
                <ScrollViewer x:Name="NotesScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" FontSize="13" LineHeight="20"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CheckedAtText" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="关闭" MinWidth="62" Style="{StaticResource ActionButton}"
                        Click="Close_OnClick" />
                <Button x:Name="DownloadButton" Content="打开下载页面" MinWidth="106" Margin="8,0,0,0"
                        Style="{StaticResource ActionButton}" Visibility="Collapsed" Click="Download_OnClick" />
                <Button x:Name="RetryButton" Content="重试" MinWidth="62" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="Retry_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
