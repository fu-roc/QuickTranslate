<Window x:Class="QuickTranslate.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="470"
        SizeToContent="Height"
        MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <StackPanel Margin="18">
        <TextBlock x:Name="TitleText"
                   Text="检查更新"
                   FontSize="15"
                   FontWeight="Medium"
                   Margin="0,0,0,10" />

        <TextBlock x:Name="StatusText"
                   Text="正在连接 GitHub…"
                   FontSize="13"
                   Foreground="#6B7280"
                   MinHeight="20"
                   TextWrapping="Wrap" />

        <Border x:Name="NotesPanel"
                Visibility="Collapsed"
                Margin="0,12,0,0"
                Padding="10"
                Background="#F5F7FA"
                BorderBrush="#E3E8EF"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText"
                           FontSize="12"
                           Foreground="#374151"
                           LineHeight="18"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="VersionText"
                   FontSize="11"
                   Foreground="#9AA0A6"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RetryButton"
                    Content="重试"
                    Width="72"
                    Margin="0,0,8,0"
                    Padding="6"
                    Visibility="Collapsed"
                    Click="Retry_OnClick" />
            <Button x:Name="DownloadButton"
                    Content="打开下载页面"
                    Width="120"
                    Margin="0,0,8,0"
                    Padding="6"
                    Visibility="Collapsed"
                    Click="Download_OnClick" />
            <Button x:Name="CloseButton"
                    Content="关闭"
                    Width="72"
                    Padding="6"
                    Click="Close_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
