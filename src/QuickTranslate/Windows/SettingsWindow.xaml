<Window x:Class="QuickTranslate.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate 设置"
        Style="{StaticResource DesktopWindow}"
        Width="530" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewMouseDown="Window_OnPreviewMouseDown">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="恢复默认"
                                    Style="{StaticResource ActionButton}" Click="ResetHotkeys_OnClick" />
                            <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="划词查词 / 翻译" VerticalAlignment="Center" />
                            <TextBox x:Name="TakeWordBox" Grid.Column="1" Style="{StaticResource TextField}"
                                     AutomationProperties.Name="划词快捷键" />
                            <Button x:Name="TakeWordRecordButton" Grid.Column="2" Content="录制"
                                    Margin="8,0,0,0" Style="{StaticResource ActionButton}"
                                    AutomationProperties.Name="录制划词快捷键" Click="Record_OnClick" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="158" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图 OCR" VerticalAlignment="Center" />
                            <TextBox x:Name="OcrBox" Grid.Column="1" Style="{StaticResource TextField}"
                                     AutomationProperties.Name="截图 OCR 快捷键" />
                            <Button Grid.Column="2" Content="录制" Margin="8,0,0,0"
                                    Style="{StaticResource ActionButton}"
                                    AutomationProperties.Name="录制截图 OCR 快捷键" Click="Record_OnClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="翻译服务" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="百度翻译 API 用于在线翻译。内置英汉词典可直接使用。"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="AppIdLabel" Text="APPID" Margin="0,0,0,4" />
                                <TextBox x:Name="AppIdBox" Style="{StaticResource TextField}"
                                         AutomationProperties.LabeledBy="{Binding ElementName=AppIdLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="SecretLabel" Text="密钥" Margin="0,0,0,4" />
                                <PasswordBox x:Name="SecretBox" Style="{StaticResource PasswordField}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=SecretLabel}" />
                            </StackPanel>
                        </Grid>
                        <DockPanel>
                            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="144"
                                      Style="{StaticResource ChoiceField}"
                                      SelectedValuePath="Code" DisplayMemberPath="Name"
                                      AutomationProperties.Name="划词和截图 OCR 的目标语言" />
                            <TextBlock Text="划词和截图 OCR 的目标语言" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="启动与更新" Style="{StaticResource SectionTitle}" Margin="0,0,0,9" />
                        <CheckBox x:Name="AutoStartBox" Content="登录 Windows 后自动启动" Margin="0,0,0,8"
                                  Foreground="{StaticResource TextBrush}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="检查更新" Style="{StaticResource ActionButton}"
                                    Click="CheckUpdate_OnClick" />
                            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" ToolTip="日志位于 %LOCALAPPDATA%\QuickTranslate\app.log" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" MinWidth="72" Margin="0,0,8,0"
                        Style="{StaticResource ActionButton}" Click="Cancel_OnClick" />
                <Button Content="保存" MinWidth="84" Style="{StaticResource PrimaryButton}" Click="Save_OnClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
