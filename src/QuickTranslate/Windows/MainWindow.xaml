<Window x:Class="QuickTranslate.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:QuickTranslate.Windows"
        Title="QuickTranslate · 手动翻译"
        Style="{StaticResource DesktopWindow}"
        Width="900" Height="540" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Closing="Window_OnClosing">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="设置" MinWidth="64"
                    Style="{StaticResource ActionButton}" Click="Settings_OnClick" />
            <TextBlock Text="手动翻译" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,9">
                        <DockPanel>
                            <ComboBox x:Name="SourceLanguageBox" DockPanel.Dock="Right" Width="132"
                                      Style="{StaticResource ChoiceField}"
                                      AutomationProperties.Name="源语言"
                                      SelectedValuePath="Code" DisplayMemberPath="Name"
                                      SelectionChanged="Language_OnChanged" />
                            <windows:PronunciationButton x:Name="PronounceSourceButton" DockPanel.Dock="Right"
                                                         Margin="8,0,8,0" MinWidth="60"
                                                         Style="{StaticResource ActionButton}"
                                                         ToolTipService.ShowOnDisabled="True"
                                                         ToolTip="朗读选中的英文或全部原文，再点一次可停止。" />
                            <TextBlock Text="原文" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="PronunciationStatus" DockPanel.Dock="Top" Margin="14,8,14,0"
                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource ErrorBrush}"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <Grid>
                        <TextBox x:Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="14,12" FontSize="15"
                                 BorderThickness="0" Background="Transparent" SpellCheck.IsEnabled="False"
                                 Foreground="{StaticResource TextBrush}"
                                 AutomationProperties.Name="原文"
                                 SelectionChanged="SourceBox_OnSelectionChanged"
                                 TextChanged="SourceBox_OnTextChanged" />
                        <TextBlock Text="输入或粘贴文本" Margin="14,12"
                                   Foreground="{StaticResource MutedBrush}" FontSize="15"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SourceBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}" Background="{StaticResource OutputBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,9">
                        <DockPanel>
                            <ComboBox x:Name="TargetLanguageBox" DockPanel.Dock="Right" Width="132"
                                      Style="{StaticResource ChoiceField}"
                                      AutomationProperties.Name="目标语言"
                                      ToolTip="仅用于手动翻译。划词和截图 OCR 的目标语言在设置中调整。"
                                      SelectedValuePath="Code" DisplayMemberPath="Name"
                                      SelectionChanged="Language_OnChanged" />
                            <TextBlock Text="译文" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="ResultBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Padding="14,12" FontSize="15"
                             Foreground="{StaticResource TextBrush}"
                             BorderThickness="0" Background="Transparent" AutomationProperties.Name="译文" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="2,10,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SettingsOnErrorButton" Content="配置翻译服务"
                    Style="{StaticResource ActionButton}" Visibility="Collapsed"
                    Margin="0,0,8,0" Click="TranslationSettings_OnClick" />
            <Button Content="清空" MinWidth="64" Style="{StaticResource ActionButton}"
                    Margin="0,0,8,0" Click="Clear_OnClick" />
            <Button x:Name="CopyButton" Content="复制译文" Style="{StaticResource ActionButton}"
                    IsEnabled="False" Margin="0,0,8,0" Click="Copy_OnClick" />
            <Button x:Name="TranslateButton" Content="翻译 (Ctrl+Enter)" MinWidth="148"
                    Style="{StaticResource PrimaryButton}" Click="Translate_OnClick" />
        </StackPanel>
    </Grid>
</Window>
