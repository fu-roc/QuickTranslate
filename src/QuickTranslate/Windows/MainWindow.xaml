<Window x:Class="QuickTranslate.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate · 翻译"
        Width="920"
        Height="580"
        MinWidth="680"
        MinHeight="420"
        Background="#FFFFFF"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Closing="Window_OnClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="QuickTranslate"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#1F2937" />
                <TextBlock Text="手动翻译 · 划词与截图仍用快捷键"
                           FontSize="12"
                           Foreground="#9AA0A6"
                           Margin="10,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="语言设置仅本窗口生效"
                           FontSize="11"
                           Foreground="#9AA0A6"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           ToolTip="划词与截图 OCR 仍按设置页的「自动检测 → 目标语言」翻译，不受这里影响。" />
                <Button Content="设置"
                        Width="62"
                        Padding="8,4"
                        Click="Settings_OnClick" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="源语言"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="SourceLanguageBox"
                              Width="132"
                              Padding="6,3"
                              SelectedValuePath="Tag"
                              SelectionChanged="Language_OnChanged"
                              ToolTip="默认自动检测。这里的选择只作用于本窗口的手动翻译。">
                        <ComboBoxItem Tag="auto" Content="自动检测" />
                        <ComboBoxItem Tag="zh" Content="简体中文" />
                        <ComboBoxItem Tag="cht" Content="繁体中文" />
                        <ComboBoxItem Tag="en" Content="英语" />
                        <ComboBoxItem Tag="jp" Content="日语" />
                        <ComboBoxItem Tag="kor" Content="韩语" />
                        <ComboBoxItem Tag="fra" Content="法语" />
                        <ComboBoxItem Tag="de" Content="德语" />
                        <ComboBoxItem Tag="spa" Content="西班牙语" />
                        <ComboBoxItem Tag="ru" Content="俄语" />
                    </ComboBox>
                </StackPanel>
                <Border BorderBrush="#E3E8EF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#FFFFFF">
                    <TextBox x:Name="SourceBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="10"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             SpellCheck.IsEnabled="False"
                             TextChanged="SourceBox_OnTextChanged" />
                </Border>
            </DockPanel>

            <TextBlock Grid.Column="1"
                       Text="→"
                       FontSize="18"
                       Foreground="#C4CBD6"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock
                               Text="译文"
                               FontSize="12"
                               Foreground="#6B7280"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TargetLanguageBox"
                              Width="132"
                              Padding="6,3"
                              SelectedValuePath="Tag"
                              SelectionChanged="Language_OnChanged"
                              ToolTip="主界面的译文语言，与设置页的划词 / OCR 目标语言相互独立。">
                        <ComboBoxItem Tag="zh" Content="简体中文" />
                        <ComboBoxItem Tag="cht" Content="繁体中文" />
                        <ComboBoxItem Tag="en" Content="英语" />
                        <ComboBoxItem Tag="jp" Content="日语" />
                        <ComboBoxItem Tag="kor" Content="韩语" />
                        <ComboBoxItem Tag="fra" Content="法语" />
                        <ComboBoxItem Tag="de" Content="德语" />
                        <ComboBoxItem Tag="spa" Content="西班牙语" />
                        <ComboBoxItem Tag="ru" Content="俄语" />
                    </ComboBox>
                </StackPanel>
                <Border BorderBrush="#E3E8EF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#F8FAFC">
                    <TextBox x:Name="ResultBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             Padding="10"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent" />
                </Border>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,10">
            <TextBlock x:Name="StatusText"
                       Text="输入文本后点「翻译」或按 Ctrl+Enter"
                       FontSize="12"
                       Foreground="#6B7280"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="CountText"
                       Text="0 字符 · 0 字节"
                       FontSize="11"
                       Foreground="#9AA0A6"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SettingsOnErrorButton"
                    Content="打开设置"
                    Width="88"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Visibility="Collapsed"
                    Click="Settings_OnClick" />
            <Button Content="清空"
                    Width="72"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    Click="Clear_OnClick" />
            <Button x:Name="CopyButton"
                    Content="复制译文"
                    Width="90"
                    Margin="0,0,8,0"
                    Padding="10,6"
                    IsEnabled="False"
                    Click="Copy_OnClick" />
            <Button x:Name="TranslateButton"
                    Content="翻译 (Ctrl+Enter)"
                    MinWidth="140"
                    Padding="14,6"
                    Background="#2F6BED"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Click="Translate_OnClick" />
        </StackPanel>
    </Grid>
</Window>
