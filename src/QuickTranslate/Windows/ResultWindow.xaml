<Window x:Class="QuickTranslate.Windows.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:windows="clr-namespace:QuickTranslate.Windows"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MaxWidth="520" MinWidth="280"
        UseLayoutRounding="True" Title="QuickTranslate">
    <Border Style="{StaticResource Panel}" BorderBrush="#B7C9E1" Padding="16,13">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentTextBrush}" />
            <DockPanel>
                <windows:PronunciationButton x:Name="PronounceSourceButton" DockPanel.Dock="Right"
                                             Margin="10,4,0,0" MinWidth="58" MinHeight="30" Padding="10,4"
                                             Style="{StaticResource ActionButton}" Focusable="False"
                                             ToolTip="播放英语发音，再点一次可停止。" Visibility="Collapsed" />
                <TextBlock x:Name="SourceText" Margin="0,4,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=DefinitionsScroll}" Value="Visible">
                                    <Setter Property="FontSize" Value="22" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <TextBlock x:Name="PronunciationStatus" FontSize="12" Margin="0,6,0,0"
                       Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />

            <ScrollViewer x:Name="ResultScroll" Margin="0,7,0,0" MaxHeight="300"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="ResultBorder" Padding="8,6" CornerRadius="6"
                        MouseLeftButtonUp="ResultBorder_OnMouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource OutputBrush}" />
                            <Style.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Cursor" Value="Hand" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource HighlightBrush}" />
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="ResultText" FontSize="15" LineHeight="23" TextWrapping="Wrap" />
                </Border>
            </ScrollViewer>

            <ScrollViewer x:Name="DefinitionsScroll" Margin="0,8,0,0" MaxHeight="280"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <ItemsControl x:Name="DefinitionItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="8,5" Margin="0,0,0,4"
                                    Cursor="Hand" Focusable="False"
                                    AutomationProperties.Name="{Binding}"
                                    AutomationProperties.HelpText="点击复制此条释义"
                                    Click="DefinitionButton_OnClick">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Background="{StaticResource OutputBrush}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource HighlightBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding}" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrush}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="SwitchButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                    Style="{StaticResource ActionButton}"
                    Visibility="Collapsed" Click="SwitchButton_OnClick" />
            <TextBlock x:Name="HintText" FontSize="12" Margin="0,8,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</Window>
