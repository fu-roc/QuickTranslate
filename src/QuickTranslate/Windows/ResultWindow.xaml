<Window x:Class="QuickTranslate.Windows.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="560"
        MinWidth="260"
        SnapsToDevicePixels="True"
        Title="">
    <Border Background="#F8FFFFFF"
            BorderBrush="#C8CDD4"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            MaxWidth="560">
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="11" Foreground="#8A8F98" Text="译文" />
            <TextBlock x:Name="SourceText"
                       FontSize="12"
                       Foreground="#6B7280"
                       Margin="0,6,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="520" />
            <Border x:Name="ResultBorder"
                    Background="Transparent"
                    Margin="0,8,0,0"
                    Cursor="Hand"
                    MouseLeftButtonUp="ResultBorder_OnMouseLeftButtonUp">
                <TextBlock x:Name="ResultText"
                           FontSize="15"
                           Foreground="#1A1A1A"
                           TextWrapping="Wrap"
                           MaxWidth="520" />
            </Border>
            <Button x:Name="SwitchButton"
                    Margin="0,10,0,0"
                    Padding="10,4"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="SwitchButton_OnClick" />
            <TextBlock x:Name="HintText"
                       FontSize="11"
                       Foreground="#A0A6AE"
                       Margin="0,10,0,0"
                       Text="点击译文复制 · Esc 关闭" />
        </StackPanel>
    </Border>
</Window>
