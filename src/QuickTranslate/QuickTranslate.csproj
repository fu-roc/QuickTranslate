<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>QuickTranslate</AssemblyName>
    <RootNamespace>QuickTranslate</RootNamespace>
    <!-- 单一版本来源：程序集、设置页、安装包都从这里读（build-installer.ps1 会解析 csproj） -->
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>QuickTranslate</Product>
    <Company>fu-roc</Company>
    <Description>极简 Windows 划词/截图 OCR 翻译工具</Description>
    <!-- 高 DPI 由 app.manifest 的 PerMonitorV2 配置，抑制 WinForms 的重复配置提示 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
